{
  "schemaVersion": 2,
  "slug": "orcha-chatbot",
  "name": "AI Chatbot",
  "description": "A production-ready conversational AI application with streaming responses and durable history.",
  "category": "chatbot",
  "tags": ["chat", "streaming", "responsive-ui"],
  "repository": {
    "host": "github",
    "owner": "Amarsia",
    "name": "orcha-chatbot-template",
    "template": true
  },
  "stack": {
    "framework": "nextjs",
    "node": ">=20.9.0"
  },
  "agent": {
    "entrypoint": "orcha/index.ts",
    "defaultAgent": "assistant"
  },
  "customization": {
    "productConfig": ["config/app.ts"],
    "agent": [
      "orcha/assistant/index.json",
      "orcha/assistant/instructions.md"
    ],
    "theme": ["app/globals.css"],
    "assets": ["public/**"]
  },
  "environment": {
    "variables": [
      {
        "key": "OPENAI_API_KEY",
        "label": "OpenAI API key",
        "required": true,
        "secret": true,
        "managedByAmarsia": true
      },
      {
        "key": "AMARSIA_PROJECT_KEY",
        "label": "Amarsia project key",
        "required": false,
        "secret": true,
        "managedByAmarsia": true
      },
      {
        "key": "AMARSIA_API_URL",
        "label": "Amarsia API URL",
        "required": false,
        "secret": false,
        "default": "https://api.amarsia.com"
      },
      {
        "key": "ORCHA_SESSION_DIRECTORY",
        "label": "Session storage directory",
        "required": false,
        "secret": false,
        "default": "/data/sessions"
      }
    ]
  },
  "validation": {
    "commands": [
      { "id": "lint", "run": "npm run lint" },
      { "id": "typecheck", "run": "npm run typecheck" },
      { "id": "agent-test", "run": "npm run agent:test" }
    ]
  },
  "deployment": {
    "type": "container",
    "dockerfile": "Dockerfile",
    "port": 3000,
    "healthcheck": "/",
    "productionCommand": ["node", "server.js"],
    "persistentStorage": {
      "path": "/data/sessions",
      "environmentVariable": "ORCHA_SESSION_DIRECTORY",
      "required": true,
      "singleInstance": true
    }
  }
}
